// ==UserScript==
// @name         bloxd.io HUD + auto
// @author       @mekrishnatyagi
// @namespace    https://mekrishnatyagi.vercel.app/
// @version      3.7
// @description  Full Bloxd.io HUD with Auto-Clicker (R for LMB, F for RMB) & (↑ for W, ← for A, ↓ for S, → for D, 0 for Jump) & (X for reset), Green Active Status for HUD boxes and Live Graphs. For more info check ⇒ https://mekrishnatyagi.vercel.app/.
// @icon         https://yt3.googleusercontent.com/SElqD7i1qME5wVLqRfBaKudMkLrsTiD2Nl1a7UuHjdugDY-n6kQ19hLBH4XQnYYZ87GPIqugFP4=s160-c-k-c0x00ffffff-no-rj
// @match        *://bloxd.io/*
// @match        https://bloxd.io/?utm_source=pwa
// @match        https://staging.bloxd.io/*
// @run-at       document-start
// @grant        none
// @license      none
// ==/UserScript==

(() => {
    'use strict';

    /* -------------------- SETTINGS -------------------- */

    const SQ = 60;
    const GAP = 8;
    const SPH = 24;
    const MBW = Math.round((SQ * 3 + GAP * 2 - GAP) / 2);
    const TOTAL_W = SQ * 3 + GAP * 2; // Exact full width of HUD (196px)
    const G_H = 28; // Clean row height for graphs

    const POSITION_KEY = 'bloxd_hud_pos';

    let hud = null;
    let dragging = false;
    let dragOffsetX = 0;
    let dragOffsetY = 0;

    // Auto-clicker states
    const autoClicker = {
        LMB: { active: false, timer: null },
        RMB: { active: false, timer: null }
    };

    // Auto movement and auto SPACE states
    const autoKeys = {
        W: { active: false, timer: null, key: 'w', code: 'KeyW', keyCode: 87 },
        A: { active: false, timer: null, key: 'a', code: 'KeyA', keyCode: 65 },
        S: { active: false, timer: null, key: 's', code: 'KeyS', keyCode: 83 },
        D: { active: false, timer: null, key: 'd', code: 'KeyD', keyCode: 68 },
        SPACE: { active: false, timer: null, key: ' ', code: 'Space', keyCode: 32 }
    };

    const keyStates = {
        W: false,
        A: false,
        S: false,
        D: false,
        SPACE: false,
        LMB: false,
        RMB: false
    };

    const keyElements = {};
    const graphBoxElements = {};
    const clickTimes = {
        LMB: [],
        RMB: []
    };

    // History buffers for real-time graphs
    const historyLength = 60;
    const graphHistory = {
        W: new Array(historyLength).fill(0),
        A: new Array(historyLength).fill(0),
        D: new Array(historyLength).fill(0),
        S: new Array(historyLength).fill(0),
        LMB: new Array(historyLength).fill(0),
        RMB: new Array(historyLength).fill(0),
        SPACE: new Array(historyLength).fill(0)
    };

    const canvasElements = {};

    /* -------------------- BEFOREUNLOAD -------------------- */

    window.addEventListener('beforeunload', event => {
        event.stopImmediatePropagation();
    }, true);

    window.onbeforeunload = null;

    /* -------------------- AD / COOKIE HIDING -------------------- */

    const hiddenSelectors = [
        '#gameadsbanner',
        '.AdContainer',
        '#cmpbox',
        '.CookieConsent',
        '[id*="fc-"]',
        '[class*="fc-"]'
    ];

    function hideSelectedElements() {
        for (const selector of hiddenSelectors) {
            document.querySelectorAll(selector).forEach(element => {
                element.style.setProperty('display', 'none', 'important');
            });
        }
    }

    const adObserver = new MutationObserver(hideSelectedElements);
    adObserver.observe(document.documentElement, { childList: true, subtree: true });

    /* -------------------- HUD CREATION -------------------- */

    function initHUD() {
        if (!document.body || hud) return;

        hud = document.createElement('div');
        hud.id = 'hud';

        hud.innerHTML = `
            <div class="row wasd-row">
                <div class="key empty"></div>
                <div class="key" id="key-W">W</div>
                <div class="key empty"></div>
            </div>
            <div class="row wasd-row">
                <div class="key" id="key-A">A</div>
                <div class="key" id="key-S">S</div>
                <div class="key" id="key-D">D</div>
            </div>
            <div class="row mouse-row">
                <div class="key mouse-key" id="key-LMB">
                    <span>LMB</span>
                    <small id="cps-LMB">0 CPS</small>
                </div>
                <div class="key mouse-key" id="key-RMB">
                    <span>RMB</span>
                    <small id="cps-RMB">0 CPS</small>
                </div>
            </div>
            <div class="key space-key" id="key-SPACE">SPACE</div>
            <div class="key restart-key" id="key-RESTART">RESTART</div>

            <!-- GRAPHS PANEL WITH LABELS -->
            <div id="graphs-panel">
                <div class="graph-box-full" id="gbox-W">
                    <span class="g-lbl">W</span>
                    <canvas id="graph-W"></canvas>
                </div>
                <div class="graph-row split-row">
                    <div class="graph-box-half" id="gbox-A">
                        <span class="g-lbl">A</span>
                        <canvas id="graph-A"></canvas>
                    </div>
                    <div class="graph-box-half" id="gbox-D">
                        <span class="g-lbl">D</span>
                        <canvas id="graph-D"></canvas>
                    </div>
                </div>
                <div class="graph-box-full" id="gbox-S">
                    <span class="g-lbl">S</span>
                    <canvas id="graph-S"></canvas>
                </div>
                <div class="graph-row split-row">
                    <div class="graph-box-half" id="gbox-LMB">
                        <span class="g-lbl">LMB</span>
                        <canvas id="graph-LMB"></canvas>
                    </div>
                    <div class="graph-box-half" id="gbox-RMB">
                        <span class="g-lbl">RMB</span>
                        <canvas id="graph-RMB"></canvas>
                    </div>
                </div>
                <div class="graph-box-full" id="gbox-SPACE">
                    <span class="g-lbl">SPACE</span>
                    <canvas id="graph-SPACE"></canvas>
                </div>
            </div>
        `;

        const style = document.createElement('style');

        style.textContent = `
            #hud {
                position: fixed;
                top: 20px;
                left: 20px;
                z-index: 2147483647;
                display: flex;
                flex-direction: column;
                gap: ${GAP}px;
                width: max-content;
                padding: 0;
                margin: 0;
                background: transparent;
                color: white;
                font-family: 'Segoe UI Light', 'Helvetica Neue', Arial, sans-serif;
                font-weight: 300;
                user-select: none;
                -webkit-user-select: none;
                pointer-events: none;
            }
            #hud .row {
                display: flex;
                gap: ${GAP}px;
                justify-content: center;
            }
            #hud .key {
                box-sizing: border-box;
                display: flex;
                align-items: center;
                justify-content: center;
                width: ${SQ}px;
                height: ${SQ}px;
                background: rgba(0, 0, 0, 0.30);
                color: rgba(255, 255, 255, 0.95);
                font-size: 19px;
                font-weight: 300;
                transition: background 0.08s ease;
            }
            #hud .empty {
                visibility: hidden;
            }
            #hud .mouse-key {
                width: ${MBW}px;
                height: ${SQ}px;
                flex-direction: column;
                gap: 2px;
                font-size: 16px;
            }
            #hud .mouse-key small {
                font-size: 10px;
                line-height: 11px;
                opacity: 0.75;
            }
            #hud .space-key,
            #hud .restart-key {
                width: 100%;
                height: ${SPH}px;
                font-size: 12px;
                letter-spacing: 1px;
            }
            #hud .active {
                background: rgba(255, 255, 255, 0.28);
            }
            /* Transparent Green when auto-clicker is active */
            #hud .auto-active {
                background: rgba(46, 204, 113, 0.35) !important;
                color: rgba(255, 255, 255, 1) !important;
            }

            /* GRAPHS PANEL STYLING WITH LABELS & PERFECT FIT */
            #graphs-panel {
                display: flex;
                flex-direction: column;
                gap: ${GAP}px;
                background: transparent;
                width: ${TOTAL_W}px;
                box-sizing: border-box;
            }
            #graphs-panel .graph-row {
                display: flex;
                gap: ${GAP}px;
                width: 100%;
                box-sizing: border-box;
            }
            #graphs-panel .split-row {
                justify-content: space-between;
            }
            .graph-box-full,
            .graph-box-half {
                position: relative;
                background: rgba(0, 0, 0, 0.30);
                display: flex;
                align-items: center;
                padding: 0 6px;
                box-sizing: border-box;
                height: ${G_H}px;
                overflow: hidden;
                transition: background 0.08s ease;
            }
            .graph-box-full.auto-active-box,
            .graph-box-half.auto-active-box {
                background: rgba(46, 204, 113, 0.35) !important;
            }
            .graph-box-full {
                width: ${TOTAL_W}px;
            }
            .graph-box-half {
                width: ${MBW}px;
            }
            .graph-box-full .g-lbl,
            .graph-box-half .g-lbl {
                font-size: 9px;
                opacity: 0.75;
                font-weight: 500;
                flex-shrink: 0;
                margin-right: 4px;
            }
            #graphs-panel canvas {
                background: transparent;
                display: block;
                box-sizing: border-box;
                flex-grow: 1;
                height: ${G_H}px;
                overflow: hidden;
            }

            #hud.dragging-mode {
                pointer-events: auto !important;
                cursor: grab !important;
                outline: 1px dashed rgba(255, 255, 255, 0.45);
                outline-offset: 4px;
            }
            #hud.dragging-mode:active {
                cursor: grabbing !important;
            }
        `;

        document.head.appendChild(style);
        document.body.appendChild(hud);

        Object.assign(keyElements, {
            W: document.getElementById('key-W'),
            A: document.getElementById('key-A'),
            S: document.getElementById('key-S'),
            D: document.getElementById('key-D'),
            LMB: document.getElementById('key-LMB'),
            RMB: document.getElementById('key-RMB'),
            SPACE: document.getElementById('key-SPACE'),
            RESTART: document.getElementById('key-RESTART')
        });

        Object.assign(graphBoxElements, {
            W: document.getElementById('gbox-W'),
            A: document.getElementById('gbox-A'),
            S: document.getElementById('gbox-S'),
            D: document.getElementById('gbox-D'),
            LMB: document.getElementById('gbox-LMB'),
            RMB: document.getElementById('gbox-RMB'),
            SPACE: document.getElementById('gbox-SPACE')
        });

        ['W', 'A', 'S', 'D', 'LMB', 'RMB', 'SPACE'].forEach(k => {
            const canvas = document.getElementById(`graph-${k}`);
            if (canvas) {
                const dpr = window.devicePixelRatio || 1;
                const boxW = (k === 'A' || k === 'D' || k === 'LMB' || k === 'RMB') ? (MBW - 22) : (TOTAL_W - 26);
                canvas.width = boxW * dpr;
                canvas.height = G_H * dpr;
            }
            canvasElements[k] = canvas;
        });

        loadPosition();
        setupDragging();
        setupMouseTracking();
        startGraphLoop();
    }

    /* -------------------- PREFERENCES & POSITION -------------------- */

    function loadPosition() {
        try {
            const saved = JSON.parse(localStorage.getItem(POSITION_KEY));
            if (
                saved &&
                typeof saved.left === 'string' &&
                typeof saved.top === 'string' &&
                saved.left.endsWith('px') &&
                saved.top.endsWith('px')
            ) {
                hud.style.left = saved.left;
                hud.style.top = saved.top;
            }
        } catch {
            localStorage.removeItem(POSITION_KEY);
        }
    }

    function savePosition() {
        localStorage.setItem(POSITION_KEY, JSON.stringify({
            left: hud.style.left,
            top: hud.style.top
        }));
    }

    /* -------------------- KEY STATES & AUTO-CLICKER -------------------- */

    function setActive(key, state) {
        keyStates[key] = state;
        const element = keyElements[key];
        if (element) {
            if (!autoClicker.LMB.active && !autoClicker.RMB.active) {
                element.classList.toggle('active', state);
            }
        }
    }

    function updateVisualState(button) {
        const element = keyElements[button];
        const gbox = graphBoxElements[button];
        const isAutoActive = autoClicker[button].active;
        const isPhysicallyPressed = keyStates[button];

        if (element) {
            element.classList.toggle('auto-active', isAutoActive);
            element.classList.toggle('active', isPhysicallyPressed && !isAutoActive);
        }
        if (gbox) {
            gbox.classList.toggle('auto-active-box', isAutoActive);
        }
    }

    function dispatchAutoKey(type, state) {
        document.dispatchEvent(new KeyboardEvent(type, {
            key: state.key,
            code: state.code,
            keyCode: state.keyCode,
            which: state.keyCode,
            bubbles: true,
            cancelable: true
        }));
    }

    function updateAutoKeyVisual(key) {
        const element = keyElements[key];
        if (element) {
            element.classList.toggle('auto-active', autoKeys[key].active);
            element.classList.toggle('active', keyStates[key] && !autoKeys[key].active);
        }
    }

    function toggleAutoKey(key) {
        const state = autoKeys[key];
        state.active = !state.active;
        updateAutoKeyVisual(key);

        if (state.active) {
            if (key === 'SPACE') {
                state.timer = setInterval(() => {
                    if (!state.active) return;
                    dispatchAutoKey('keydown', state);
                    setTimeout(() => dispatchAutoKey('keyup', state), 40);
                }, 100);
            } else {
                dispatchAutoKey('keydown', state);
                state.timer = setInterval(() => {
                    if (state.active) dispatchAutoKey('keydown', state);
                }, 80);
            }
        } else {
            clearInterval(state.timer);
            state.timer = null;
            dispatchAutoKey('keyup', state);
        }
    }

    function triggerClickEvent(buttonName, buttonCode) {
        const now = Date.now();
        clickTimes[buttonName].push(now);

        const target = document.elementFromPoint(window.innerWidth / 2, window.innerHeight / 2) || document.body;
        const mouseEventOptions = {
            bubbles: true,
            cancelable: true,
            view: window,
            button: buttonCode,
            buttons: buttonCode === 0 ? 1 : 2
        };

        target.dispatchEvent(new MouseEvent('mousedown', mouseEventOptions));
        target.dispatchEvent(new MouseEvent('mouseup', mouseEventOptions));
        target.dispatchEvent(new MouseEvent('click', mouseEventOptions));
    }

    function toggleAutoClicker(button) {
        autoClicker[button].active = !autoClicker[button].active;
        updateVisualState(button);

        if (autoClicker[button].active) {
            const intervalMs = Math.floor(Math.random() * 8) + 53; // ~17-18 CPS
            const buttonCode = button === 'LMB' ? 0 : 2;

            autoClicker[button].timer = setInterval(() => {
                if (!autoClicker[button].active) return;
                triggerClickEvent(button, buttonCode);
            }, intervalMs);
        } else {
            clearInterval(autoClicker[button].timer);
            autoClicker[button].timer = null;
        }
    }

    /* -------------------- RESET -------------------- */

    function instantReset() {
        try {
            const savedPosition = localStorage.getItem(POSITION_KEY);
            localStorage.clear();
            if (savedPosition !== null) {
                localStorage.setItem(POSITION_KEY, savedPosition);
            }
            sessionStorage.clear();
            document.cookie.split(';').forEach(cookie => {
                const name = cookie.split('=')[0].trim();
                document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/';
            });
        } catch (error) {
            console.warn('HUD reset:', error);
        }
        location.reload();
    }

    /* -------------------- KEYBOARD EVENTS -------------------- */

    function isTypingTarget(target) {
        return target instanceof HTMLElement && (
            target.isContentEditable ||
            ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName)
        );
    }

    document.addEventListener('keydown', event => {
        if (event.repeat || isTypingTarget(event.target)) return;

        const key = event.key.toUpperCase();

        if (key === 'W' || key === 'A' || key === 'S' || key === 'D') {
            setActive(key, true);
        }
        if (key === ' ') {
            setActive('SPACE', true);
        }
        if (key === 'X') {
            instantReset();
        }
        if (event.code === 'ArrowUp') {
            toggleAutoKey('W');
        }
        if (event.code === 'ArrowLeft') {
            toggleAutoKey('A');
        }
        if (event.code === 'ArrowDown') {
            toggleAutoKey('S');
        }
        if (event.code === 'ArrowRight') {
            toggleAutoKey('D');
        }
        if (event.code === 'Numpad0' || event.code === 'Digit0') {
            toggleAutoKey('SPACE');
        }
        if (key === 'R') {
            toggleAutoClicker('LMB');
        }
        if (key === 'F') {
            toggleAutoClicker('RMB');
        }
        if (event.key === 'Alt' && hud) {
            hud.classList.add('dragging-mode');
        }
    }, true);

    document.addEventListener('keyup', event => {
        const key = event.key.toUpperCase();

        if (key === 'W' || key === 'A' || key === 'S' || key === 'D') {
            setActive(key, false);
        }
        if (key === ' ') {
            setActive('SPACE', false);
        }
        if (event.key === 'Alt' && hud) {
            hud.classList.remove('dragging-mode');
            dragging = false;
            savePosition();
        }
    }, true);

    window.addEventListener('blur', () => {
        if (hud) {
            hud.classList.remove('dragging-mode');
            dragging = false;
        }
        for (const key of ['W', 'A', 'S', 'D', 'SPACE']) {
            setActive(key, false);
        }
    });

    /* -------------------- MOUSE TRACKING -------------------- */

    function setupMouseTracking() {
        document.addEventListener('mousedown', event => {
            if (event.button === 0) {
                clickTimes.LMB.push(Date.now());
                setActive('LMB', true);
            }
            if (event.button === 2) {
                clickTimes.RMB.push(Date.now());
                setActive('RMB', true);
            }
        }, true);

        document.addEventListener('mouseup', event => {
            if (event.button === 0) {
                setActive('LMB', false);
                updateVisualState('LMB');
            }
            if (event.button === 2) {
                setActive('RMB', false);
                updateVisualState('RMB');
            }
        }, true);

        document.addEventListener('contextmenu', () => {
            setActive('RMB', false);
            updateVisualState('RMB');
        }, true);

        document.addEventListener('mouseleave', () => {
            if (!autoClicker.LMB.active) setActive('LMB', false);
            if (!autoClicker.RMB.active) setActive('RMB', false);
        }, true);

        setInterval(updateCPS, 200);
    }

    function updateCPS() {
        const now = Date.now();
        for (const button of ['LMB', 'RMB']) {
            clickTimes[button] = clickTimes[button].filter(
                time => now - time <= 1000
            );

            const display = document.getElementById(`cps-${button}`);
            if (display) {
                display.textContent = `${clickTimes[button].length} CPS`;
            }
        }
    }

    /* -------------------- GRAPH RENDERING LOOP -------------------- */

    function startGraphLoop() {
        // Track frame counts per key to create pulse waves when auto-clicking
        const pulseCounters = { LMB: 0, RMB: 0 };

        function renderLoop() {
            for (const key of ['W', 'A', 'S', 'D', 'LMB', 'RMB', 'SPACE']) {
                let isPressed = keyStates[key] || (autoKeys[key] && autoKeys[key].active);

                if (key === 'LMB' && autoClicker.LMB.active) {
                    pulseCounters.LMB++;
                    // Toggle state every few frames to simulate up/down click peaks in graph
                    isPressed = (Math.floor(pulseCounters.LMB / 2) % 2 === 0);
                } else if (key === 'RMB' && autoClicker.RMB.active) {
                    pulseCounters.RMB++;
                    isPressed = (Math.floor(pulseCounters.RMB / 2) % 2 === 0);
                }

                const arr = graphHistory[key];
                arr.shift();
                arr.push(isPressed ? 1 : 0);

                const canvas = canvasElements[key];
                if (!canvas) continue;
                const ctx = canvas.getContext('2d');
                const w = canvas.width;
                const h = canvas.height;

                ctx.clearRect(0, 0, w, h);

                ctx.beginPath();
                if ((key === 'LMB' && autoClicker.LMB.active) || (key === 'RMB' && autoClicker.RMB.active)) {
                    ctx.strokeStyle = 'rgba(46, 204, 113, 0.95)';
                } else {
                    ctx.strokeStyle = 'rgba(255, 255, 255, 0.85)';
                }
                ctx.lineWidth = 2;

                const step = w / (historyLength - 1);
                for (let i = 0; i < arr.length; i++) {
                    const val = arr[i];
                    const x = i * step;
                    const y = val === 1 ? 6 : h - 6;

                    if (i === 0) ctx.moveTo(x, y);
                    else ctx.lineTo(x, y);
                }
                ctx.stroke();
            }

            requestAnimationFrame(renderLoop);
        }
        requestAnimationFrame(renderLoop);
    }

    /* -------------------- ALT + DRAG -------------------- */

    function setupDragging() {
        hud.addEventListener('mousedown', event => {
            if (!event.altKey || event.button !== 0) return;

            dragging = true;
            const rect = hud.getBoundingClientRect();

            dragOffsetX = event.clientX - rect.left;
            dragOffsetY = event.clientY - rect.top;

            event.preventDefault();
        });

        document.addEventListener('mousemove', event => {
            if (!dragging || !event.altKey) return;

            hud.style.left = `${event.clientX - dragOffsetX}px`;
            hud.style.top = `${event.clientY - dragOffsetY}px`;
        });

        document.addEventListener('mouseup', () => {
            if (!dragging) return;

            dragging = false;
            savePosition();
        });
    }

    /* -------------------- INITIALIZATION -------------------- */

    function waitForBody() {
        if (document.body) {
            initHUD();
        } else {
            requestAnimationFrame(waitForBody);
        }
    }

    waitForBody();

})();
